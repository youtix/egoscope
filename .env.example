# Server environment, validated once in src/lib/env/server-env.ts.
# For local development, copy this file to .env.local and adjust it. Never commit
# real values: in production they live in the hosting configuration (TRV-64).

# Minimum level of the server log: debug, info, warn or error. Default: info.
LOG_LEVEL=info

# The database (TRV-14), two secrets from the Neon console: the pooled connection
# string, for the application, and the direct one, for migrations and long reads.
# Both must ask for sslmode=verify-full. Set them in Vercel for Production only,
# never for previews. Leave them unset outside Vercel: the application then runs
# on PGlite, kept on disk in .pglite/ by `next dev` and in memory otherwise.
# DATABASE_URL=postgresql://egoscope:placeholder@pooled.example.invalid/egoscope?sslmode=verify-full
# DATABASE_URL_UNPOOLED=postgresql://egoscope:placeholder@direct.example.invalid/egoscope?sslmode=verify-full

# Set by the platform, never by hand: VERCEL_ENV (production, preview or
# development) on Vercel deployments, NODE_ENV by Next.js and Vitest.
