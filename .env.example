# Server environment, validated once in src/lib/env/server-env.ts, under the names of
# docs/services/accounts-and-keys.md. For local development, copy this file to .env.local.
# Never commit real values (TRV-64): the owner enters them in Vercel, for Production only,
# never for previews. An empty value counts as unset. Outside Vercel nothing is required:
# the application runs on PGlite, kept on disk in .pglite/ by `next dev` and in memory
# otherwise, with the fakes below. A Vercel deployment needs every value that its lot
# requires, the backup values aside, and names the missing ones.

# Minimum level of the server log: debug, info, warn or error; info when unset.
LOG_LEVEL=info

# --- Lot 1, set by the owner in Vercel ---------------------------------------------------

# The production address of the application, https://<project>.vercel.app.
# APP_BASE_URL=https://egoscope.example.invalid

# Secret: Neon's pooled connection string, for the application; must say sslmode=verify-full.
# DATABASE_URL=postgresql://egoscope:placeholder@pooled.example.invalid/egoscope?sslmode=verify-full

# Secret: Neon's direct connection string, for migrations and long reads; sslmode=verify-full too.
# DATABASE_URL_UNPOOLED=postgresql://egoscope:placeholder@direct.example.invalid/egoscope?sslmode=verify-full

# Secret: the trigger secret of the scheduled tasks, generated, also set in the tick Worker.
# CRON_SECRET=<32 random bytes in base64url, from the command of the accounts-and-keys sheet>

# Secret: the initial password of the account, chosen by the owner, at least 12 characters, the value of `auth.passwordMinLength`.
# INITIAL_PASSWORD=<the initial password>

# Secret: the key of the temporary fingerprint of withdrawn events, generated.
# FINGERPRINT_KEY=<32 random bytes in base64url, from the command of the accounts-and-keys sheet>

# The private backup repository; without the three backup values, backups fail and say so.
# BACKUP_GITHUB_REPOSITORY=<owner>/egoscope-backups

# Secret: the fine-grained GitHub token, Contents read and write on the backup repository only.
# BACKUP_GITHUB_TOKEN=<the fine-grained token>

# Secret: the key of the backups, generated in base64; keep a copy in a password manager.
# BACKUP_ENCRYPTION_KEY=<32 random bytes in base64, from the command of the accounts-and-keys sheet>

# A mirror or a test server of the statistics files; the source's public address when unset.
# STATS_SOURCE_BASE_URL=https://mirror.example.invalid/releases/download

# --- Lot 2, set by the owner in Vercel ---------------------------------------------------

# The Cloudflare account ID shown on the Workers AI page.
# CLOUDFLARE_ACCOUNT_ID=<the account ID>

# Secret: the Workers AI token, with Workers AI Read and Workers AI Edit only.
# CLOUDFLARE_AI_API_TOKEN=<the Workers AI token>

# Secret, optional: the GroqCloud key; without it, the detection runs on Workers AI alone.
# GROQ_API_KEY=<the GroqCloud key>

# Secret: the token of the Telegram bot, from BotFather.
# TELEGRAM_BOT_TOKEN=<the bot token>

# Secret: the secret of the Telegram webhook, generated.
# TELEGRAM_WEBHOOK_SECRET=<32 random bytes in base64url, from the command of the accounts-and-keys sheet>

# --- Set by the repository, never by the owner -------------------------------------------

# The lot of the build, 1 or 2; the build configuration sets it, 1 when unset.
# EGOSCOPE_LOT=1

# Fakes: all, the default here, or ports among stats-source, link-check, backup-storage, runtime-cache, language-model, press-feeds and telegram; refused beside a real credential and in production.
EGOSCOPE_FAKES=all

# --- Set by the platform, never by hand --------------------------------------------------

# Set by Vercel: production, preview or development; absent outside Vercel.
# VERCEL_ENV=production

# Set by Vercel: the unique identifier of the deployment; absent outside Vercel.
# VERCEL_DEPLOYMENT_ID=<the deployment id>

# Set by Next.js and Vitest: development, production or test.
# NODE_ENV=development
