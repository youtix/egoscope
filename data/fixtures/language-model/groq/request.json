{
  "url": "https://api.groq.com/openai/v1/chat/completions",
  "method": "POST",
  "headers": { "content-type": "application/json" },
  "body": {
    "model": "openai/gpt-oss-120b",
    "messages": [
      {
        "role": "system",
        "content": "Report the facts that each article tells of each recognized player.\n\nType sheets: public_dispute.\n\nDo not repropose: none."
      },
      {
        "role": "user",
        "content": "{\"articles\":[{\"id\":\"article-1\",\"text\":\"Title and excerpt of article 1.\"},{\"id\":\"article-2\",\"text\":\"Title and excerpt of article 2.\"}]}"
      }
    ],
    "response_format": {
      "type": "json_schema",
      "json_schema": {
        "name": "classification",
        "strict": true,
        "schema": {
          "type": "object",
          "properties": { "articles": { "type": "array", "items": { "type": "object" } } },
          "required": ["articles"],
          "additionalProperties": false
        }
      }
    },
    "reasoning_effort": "low",
    "max_completion_tokens": 1000
  }
}
