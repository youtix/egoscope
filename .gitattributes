# Text files are stored and checked out with LF line endings on every platform.
* text=auto eol=lf

# Binary assets are never normalized.
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.woff binary
*.woff2 binary

# The lockfile is generated: collapse it in GitHub diffs.
bun.lock linguist-generated=true
